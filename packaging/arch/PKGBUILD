# Maintainer: Oleksandr Popov <anantaramdas@outlook.com>
#
# Builds the package from this checkout:  cd packaging/arch && makepkg -si
# The plugin is compiled against the installed digiKam; rebuild it after
# digiKam upgrades (makepkg -sif).
pkgname=digikam-icloud-photos
pkgver=1.0.0
pkgrel=1
pkgdesc="digiKam plugin to sync with iCloud Photos: incremental import, upload, command line"
arch=(x86_64)
url="https://github.com/popovoleksandr/digikam-icloud-plugin"
license=(GPL-3.0-or-later)
depends=(digikam qt6-base python python-requests)
makedepends=(cmake)
optdepends=('perl-image-exiftool: write album tags and ratings into HEIC files')
options=(!debug)
source=()

_src="$startdir/../.."

build() {
  cmake -S "$_src" -B build \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  python -m compileall -q -d /usr/share/$pkgname "$pkgdir/usr/share/$pkgname"
  install -Dm644 "$_src/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$_src/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
